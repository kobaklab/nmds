.venv/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/

# input data (not tracked); keep its README
data/*
!data/README.md

# pipeline outputs (embeddings, metrics, CSVs, environment info); regenerated by the scripts.
# The .gitkeep only keeps the empty folder in the repository.
results/*
!results/.gitkeep
!results/all_runs.csv
!results/environment.json
!results/ablations/
!results/ablations/*.csv
